# Safe local defaults. Copy this file to .env to override process settings.
# Never put real secrets in this example file.
PORTFOLIO_RAG_API_SERVICE_NAME=portfolio-rag-api
# Local-only placeholder credentials used by the Compose PostgreSQL service.
PORTFOLIO_RAG_API_DATABASE_URL=postgresql+asyncpg://portfolio_rag:portfolio_rag@127.0.0.1:5432/portfolio_rag
# AWS injects the equivalent host, port, name, username, and password component
# settings separately; do not set DATABASE_URL there.
PORTFOLIO_RAG_API_DATABASE_CONNECTION_TIMEOUT_SECONDS=2
# Local development is deliberately unauthenticated. AWS sets alb_cognito and
# injects the exact ALB ARN, Cognito pool/client IDs, managed-login domain,
# application URL, and authorized reviewers group through the task definition.
PORTFOLIO_RAG_API_AUTHENTICATION_MODE=disabled
PORTFOLIO_RAG_UI_API_BASE_URL=http://127.0.0.1:8000
PORTFOLIO_RAG_UI_API_TIMEOUT_SECONDS=5
