{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:${aws_partition}:s3:::${state_bucket_name}"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:${aws_partition}:s3:::${state_bucket_name}/${state_key_prefix}/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeImages",
        "ecr:DescribeRepositories"
      ],
      "Resource": [
        "arn:${aws_partition}:ecr:${aws_region}:${account_id}:repository/portfolio-rag-api",
        "arn:${aws_partition}:ecr:${aws_region}:${account_id}:repository/portfolio-rag-ui"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:DescribeTaskDefinition",
        "ecs:DescribeTasks",
        "ecs:ListTasks",
        "ecs:RegisterTaskDefinition",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "ecs:TagResource",
      "Resource": [
        "arn:${aws_partition}:ecs:${aws_region}:${account_id}:task-definition/${name_prefix}:*",
        "arn:${aws_partition}:ecs:${aws_region}:${account_id}:task-definition/${name_prefix}-migration:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "portfolio-rag-lab"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:${aws_partition}:ecs:${aws_region}:${account_id}:task-definition/${name_prefix}-migration:*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:${aws_partition}:ecs:${aws_region}:${account_id}:cluster/${name_prefix}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:ListServiceDeployments",
        "ecs:UpdateService"
      ],
      "Resource": "arn:${aws_partition}:ecs:${aws_region}:${account_id}:service/${name_prefix}/${name_prefix}"
    },
    {
      "Effect": "Allow",
      "Action": "ecs:DescribeServiceDeployments",
      "Resource": [
        "arn:${aws_partition}:ecs:${aws_region}:${account_id}:service/${name_prefix}/${name_prefix}",
        "arn:${aws_partition}:ecs:${aws_region}:${account_id}:service-deployment/${name_prefix}/${name_prefix}/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:${aws_partition}:iam::${account_id}:role/${name_prefix}-application-task",
        "arn:${aws_partition}:iam::${account_id}:role/${name_prefix}-ecs-execution"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
